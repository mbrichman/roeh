#!/usr/bin/env python3
"""SessionStart — put the record back in front of the model.

Two distinct jobs, keyed on `trigger`:

  compact / clear / fork
      The context that just died is not coming back. Inject the trace pointer
      and §5 RESUME STATE verbatim so the fresh context starts knowing where
      the project actually is. This is the half that makes an append-only
      trace *work* — writing it is pointless if nothing reads it back.

  startup / resume
      A cheap staleness line, plus the standing instruction to consult the
      oracle BEFORE re-deriving a decision. The failure this exists to stop is
      not ignorance, it is confident re-derivation of something already
      settled — which only ever happens at the start of a session.

Reads no more than RESUME_BUDGET of §5 so a large trace cannot crowd out the
context it is meant to inform.
"""
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
RESUME_BUDGET = 6000


def out(payload, context=None):
    if context:
        payload.setdefault("hookSpecificOutput", {})
        payload["hookSpecificOutput"]["hookEventName"] = "SessionStart"
        payload["hookSpecificOutput"]["additionalContext"] = context
    print(json.dumps(payload))
    sys.exit(0)


def section(path, marker):
    """Pull one §N section out of the trace.

    Deliberately tolerant of heading depth and of '§5'/'5.' styles: the trace
    is hand-edited by a human under time pressure, and a fragile parser here
    would silently return nothing exactly when the record matters most.
    """
    try:
        text = open(path, errors="ignore").read()
    except Exception:
        return ""
    pat = re.compile(rf"^#{{1,6}}\s*(?:§\s*)?{marker}\b.*$", re.M)
    hits = list(pat.finditer(text))
    if not hits:
        return ""
    # LAST occurrence, not first. The file is append-only, so a section is
    # superseded by appending a new copy of it rather than editing the old one
    # — which means the first §5 in the file is the oldest resume state, not
    # the current one. Reading the first injected a stale state into the very
    # context that has nothing else to check it against, which is the precise
    # failure this hook exists to prevent. Found by refreshing roeh's own trace.
    m = hits[-1]
    start = m.start()
    nxt = re.compile(r"^#{1,6}\s*(?:§\s*)?\d+\b", re.M).search(text, m.end())
    body = text[start:nxt.start() if nxt else len(text)]
    if len(body) > RESUME_BUDGET:
        body = body[:RESUME_BUDGET] + "\n\n…[§5 truncated — read the file for the rest]"
    return body.strip()


def main():
    try:
        event = json.load(sys.stdin)
    except Exception:
        event = {}
    trigger = event.get("trigger", "startup")
    cwd = event.get("cwd") or os.getcwd()

    # Exclude the active session from the behind-check: an in-progress transcript
    # is not "behind", and warning about the session you are in on every startup
    # is noise. It becomes minable next session, where it is no longer active.
    active = event.get("session_id")
    status_cmd = [sys.executable, os.path.join(HERE, "roeh"), "status", "--json"]
    if active:
        status_cmd += ["--session", active]

    try:
        raw = subprocess.run(status_cmd, cwd=cwd, capture_output=True,
                             text=True, timeout=20).stdout
        st = json.loads(raw)
    except Exception:
        out({})

    if not st.get("trace_exists"):
        # Only advertise on a real session start; not worth a line mid-compact.
        if trigger in ("startup", "resume") and st.get("initialized"):
            out({"systemMessage": "roeh: no decision trace yet — /roeh:ingest"})
        out({})

    trace = st["trace"]
    header = (
        f"⭑ DECISION TRACE: {trace} ({st['trace_lines']} lines)\n"
        "This project keeps an append-only record of WHY things were decided — "
        "decisions, dead-ends, reversals, lessons. Consult the `oracle` agent "
        "BEFORE re-deriving any architecture, eval, model choice or design "
        "decision, and before re-walking anything that might be a known "
        "dead-end. The oracle answers 'why'; it cites the record.\n"
    )

    if trigger in ("compact", "clear", "fork"):
        resume = section(trace, "5")
        body = header + (
            "\nThe context that preceded this point is gone. The record is not. "
            "Below is §5 RESUME STATE verbatim — treat it as authoritative on "
            "where the project stands, and re-read the full trace before any "
            "structural decision.\n\n" + resume if resume else
            "\n§5 RESUME STATE is missing from the trace — read the last dated "
            "chapter of §3 before proceeding.")
        out({}, body)

    # Surface structural breakage, not just staleness. `claude plugin update`
    # moves the plugin; nothing in the harness migrates a project's artifacts to
    # match, and a half-migrated record fails silently. Only FAILs are shown —
    # warnings on every session start are how a check gets tuned out.
    broken = ""
    try:
        d = subprocess.run([sys.executable, os.path.join(HERE, "roeh"), "doctor"],
                           cwd=cwd, capture_output=True, text=True, timeout=20)
        if d.returncode != 0:
            fails = [ln.strip() for ln in d.stdout.splitlines() if ln.strip().startswith("✗")]
            if fails:
                broken = ("\n⚠️ roeh doctor reports structural problems with this "
                          "project's record:\n" + "\n".join("  " + f for f in fails)
                          + "\nRun `roeh doctor` for the fixes. Until these are "
                          "resolved, treat oracle answers as unverified.\n")
    except Exception:
        pass

    stale = ""
    bits = []
    if st.get("behind"):
        if st["commits"]:
            bits.append(f"{len(st['commits'])} unrecorded commit(s)")
        if st["unmined_sessions"]:
            bits.append(f"{len(st['unmined_sessions'])} unmined session(s)")
        if st["memory_changed"]:
            bits.append(f"{len(st['memory_changed'])} changed memory file(s)")
        stale = (f"\n⚠️ The record is BEHIND THE WORK: {', '.join(bits)}. "
                 "Run /roeh:refresh to reconcile before relying on the oracle "
                 "for anything touching recent work — an answer sourced from a "
                 "stale record reads exactly like an answer sourced from a "
                 "current one.\n")

    out({"systemMessage":
         ("✗ roeh doctor: structural problems with the record — run `roeh doctor`"
          if broken else
          f"⚠️  roeh: trace is behind ({', '.join(bits)}) — /roeh:refresh"
          if stale else
          f"✓ roeh: trace current ({st['trace_lines']} lines)")},
        header + broken + stale)


if __name__ == "__main__":
    main()
