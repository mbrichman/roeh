#!/usr/bin/env python3
"""PreCompact gate — the moment unrecorded decisions die.

Compaction summarises away the reasoning that produced the work. The commits
survive; the *why* does not. This fires immediately before that happens.

It does not nag unconditionally — an unconditional reminder is tuned out by
week two. It compares the trace against evidence that work actually happened
(commits, unmined transcripts, changed memory files) and only speaks when the
record is genuinely behind, naming the specific items so the entry can be
written from evidence rather than from a fading context.

Policy, per trigger:
  manual — BLOCK (exit 2). You typed /compact, so there is context room to
           record first. Blocking here costs a minute and saves the rationale.
  auto   — NEVER block. Auto-compact fires when the window is already full;
           refusing it there can wedge the session with nowhere to go. A loud
           injected reminder that survives into the post-compaction context is
           the right instrument.

Escape hatch: ROEH_SKIP=1 disables the block. A gate with no bypass is a wedge
waiting for the one night you genuinely need to compact and move on.
"""
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
MAX_LISTED = 15


def out(payload, code=0):
    if payload:
        print(json.dumps(payload))
    sys.exit(code)


def main():
    try:
        event = json.load(sys.stdin)
    except Exception:
        event = {}
    trigger = event.get("trigger", "auto")
    cwd = event.get("cwd") or os.getcwd()

    # Exclude THIS session from the behind-check. Its transcript is still being
    # written, so it is always "unmined" against itself — counting it made this
    # gate unsatisfiable, wedging the very /compact that fired the hook.
    active = event.get("session_id")
    status_cmd = [sys.executable, os.path.join(HERE, "roeh"), "status", "--json"]
    if active:
        status_cmd += ["--session", active]

    try:
        raw = subprocess.run(status_cmd, cwd=cwd, capture_output=True,
                             text=True, timeout=20).stdout
        st = json.loads(raw)
    except Exception:
        out({})  # No config, no trace, no git — stay silent rather than noisy.

    if not st.get("trace_exists"):
        out({})
    if not st.get("behind"):
        out({"systemMessage":
             f"✓ decision trace current ({st['trace_lines']} lines, written "
             f"{st['hours_since']:.1f}h ago)"})

    commits = st.get("commits", [])
    sessions = st.get("unmined_sessions", [])
    memory = st.get("memory_changed", [])

    lines = []
    if commits:
        listed = commits[:MAX_LISTED]
        lines.append(f"{len(commits)} unrecorded commit(s):")
        lines += [f"  - {c['sha']} {c['subject']}" for c in listed]
        if len(commits) > len(listed):
            lines.append(f"  …and {len(commits) - len(listed)} more")
    if sessions:
        lines.append(f"{len(sessions)} unmined session transcript(s) — "
                     "real-time rationale the commits do not hold:")
        lines += [f"  - {s['id']} ({s['size']//1024}KB)" for s in sessions[:5]]
    if memory:
        lines.append(f"{len(memory)} memory file(s) changed since: "
                     + ", ".join(memory[:8]))
    evidence = "\n".join(lines)

    # NOTE: this hook injects nothing into the model's context. PreCompact does
    # NOT support `hookSpecificOutput.additionalContext` — Claude Code rejects
    # that shape ("Hook JSON output validation failed"), and an earlier version
    # of this file emitted it, so the nag it was trying to deliver was silently
    # dropped on every compaction. The context that must survive a compaction is
    # delivered by the SessionStart hook (trigger=compact), which re-injects §5
    # RESUME STATE and the "behind → /roeh:refresh" prompt into the fresh
    # post-compaction context — the one supported channel. So the two jobs split
    # cleanly: this hook BLOCKS a manual /compact (exit 2 + stderr) and drops the
    # scribe sentinel; SessionStart carries the reminder across. `systemMessage`
    # (a user-facing line, valid for any hook) is all we emit here.

    pc = st.get("precompact") or {}

    # Drop the sentinel BEFORE deciding to block. Hook handlers inside one
    # event have no documented order, so this must be readable by the scribe
    # whether it is dispatched before or after this script runs.
    #
    # `record: false` withholds it deliberately. The scribe is still dispatched
    # by hooks.json — that entry is plugin-level and cannot be disabled per
    # project — but with no sentinel it finds nothing pending and stays in
    # DRAFT mode, returning entries instead of appending them. That is the
    # read-only posture: a project with a hand-curated record gets the reminder
    # and the draft, and keeps a human as the only writer.
    if not pc.get("record", True):
        # No sentinel is dropped, so the scribe (dispatched by hooks.json) finds
        # nothing pending and stays in DRAFT mode — it returns entries instead of
        # appending them, keeping a human the only writer. Read-only never blocks.
        out({
            "systemMessage": (
                f"⚠️  trace is behind: {len(commits)} commit(s) — read-only "
                "mode (precompact.record: false). The scribe will DRAFT entries "
                "for the owner to approve; nothing is appended automatically."),
        })

    try:
        subprocess.run([sys.executable, os.path.join(HERE, "roeh"),
                        "pending", "--write"], cwd=cwd, text=True, timeout=10,
                       input=json.dumps({"trigger": trigger,
                                         "evidence": evidence,
                                         "commits": commits,
                                         "sessions": sessions,
                                         "memory": memory}),
                       capture_output=True)
    except Exception:
        pass

    # Honour the config. These two keys were written into every config from the
    # first version and never read — a gate whose knob does nothing is worse
    # than a gate with no knob, because the owner believes they turned it off.
    blocking = (trigger == "manual"
                and pc.get("block_manual", True)
                and not os.environ.get("ROEH_SKIP"))
    if trigger == "auto" and not pc.get("nag_auto", True):
        out({})
    if blocking:
        # exit 2 blocks compaction; stderr is what the user and model see.
        print(
            "COMPACTION BLOCKED — the decision trace is behind the work.\n\n"
            f"{evidence}\n\n"
            "Record these first: dispatch the `scribe` agent, then "
            "`roeh append`. Re-run /compact when the trace is current.\n"
            "To compact anyway: ROEH_SKIP=1 (the rationale above will be lost).",
            file=sys.stderr)
        sys.exit(2)

    # Non-blocking (auto-compact, or manual with block_manual:false). The
    # sentinel is dropped and the scribe will record; SessionStart(compact)
    # re-injects the reminder afterward. A user-facing line is all this emits.
    out({
        "systemMessage": (
            f"⚠️  trace is behind: {len(commits)} commit(s), "
            f"{len(sessions)} unmined session(s) — recording before compaction"),
    })


if __name__ == "__main__":
    main()
