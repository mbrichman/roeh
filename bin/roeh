#!/usr/bin/env python3
"""roeh — the decision-trace CLI.

Every other piece of this plugin (the Oracle, the scribe, the hooks, the
skills) resolves paths and staleness through this one binary. That is
deliberate: the alternative is each component carrying its own copy of "where
does the trace live", which is exactly how a tool ends up with four subtly
different answers and no one able to say which is authoritative.

Subcommands:
  init      write .claude/roeh.json (config only); the trace itself is created
            by /roeh:ingest (v3 skeleton), not here
  config    resolve and print the effective config
  status    is the record behind the work? (commits / sessions / memory)
  append    APPEND raw text to the trace — the low-level write primitive
  record    APPEND one structured v3 entry (JSON on stdin): assigns a content
            id, validates edges, chains and fsyncs under an exclusive lock
  id        compute an entry's content-id (JSON on stdin) WITHOUT writing —
            for referencing an edge target before it is recorded
  sessions  list this project's Claude Code transcripts, mined or not
  slug      compute the Claude Code project-directory slug for a path
  mark      record that a session/commit has been folded into the trace
  doctor    check this project's artifacts against the running plugin
            (--fix applies the safe repairs; never touches the trace)
  ingest    ingest lifecycle: status | begin | done | end | abandon
            (so an interrupted run is a fact, not a guess)
  map       fold the log into the root control plane + bloom sidecar (the
            derived read model); read via `roeh read`, freshness via `roeh verify`
  read      pull one CP or entry exactly: a region, region/N, an id, §N,
            @ledger, or group:N — sub-reads inherit the map's projection context
  scope     debug a query's literal drill set (the regions its tokens hit)
  verify    map freshness + chain integrity vs the log (exit 6 stale / 7 tamper)

No third-party dependencies, by design: this runs inside hooks, where a
missing import is a silent failure at the worst possible moment.
"""
import json
import os
import re
import subprocess
import sys
import time

# `roeh read` emits large output that is routinely piped (`| head`, `| less`). Restore the default
# SIGPIPE disposition so a closed reader kills us quietly instead of a BrokenPipeError traceback.
try:
    import signal
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (ImportError, AttributeError, ValueError):
    pass

CONFIG_NAME = "roeh.json"
STATE_NAME = "roeh-state.json"
SCHEMA_VERSION = 1

MIN_PYTHON = (3, 8)
if sys.version_info < MIN_PYTHON:
    # Fail loudly and specifically. This runs inside hooks, where the default
    # failure is silence — the gate simply does not fire and nobody notices
    # until a decision has already been lost.
    sys.stderr.write(
        "roeh requires Python %d.%d or newer; this is %d.%d at %s\n"
        % (MIN_PYTHON[0], MIN_PYTHON[1], sys.version_info[0],
           sys.version_info[1], sys.executable))
    sys.exit(1)


# ---------------------------------------------------------------- utilities

def die(msg, code=1):
    # Flush stdout first: several commands print context (the current config,
    # the two competing paths) and THEN refuse. Unflushed, the refusal lands
    # above the context that explains it.
    sys.stdout.flush()
    print(f"roeh: {msg}", file=sys.stderr)
    sys.exit(code)


def run(args, cwd=None, timeout=15):
    """Run a command, returning stdout or "" — never raising.

    Hooks must not crash the session. A git call that fails (not a repo, git
    absent, a corrupt index) degrades to "no evidence of work", which makes
    the caller quieter, not louder. Failing open is the safe direction here.
    """
    try:
        p = subprocess.run(args, cwd=cwd, capture_output=True, text=True,
                           timeout=timeout)
        return p.stdout.strip()
    except Exception:
        return ""


def slug_for(path):
    """Claude Code's project-directory slug: '/' and '.' both become '-'.

    /Users/x/projects/thing       -> -Users-x-projects-thing
    /Users/x/.claude/projects     -> -Users-x--claude-projects
    """
    return re.sub(r"[/.]", "-", os.path.abspath(path))


def find_project_root(start):
    """Nearest ancestor carrying a project marker.

    NEAREST is the whole point, and getting it wrong here is not subtle. An
    earlier version exhausted each marker upward before trying the next, so a
    `.claude/` directory several levels up beat a `.git/` sitting in the
    directory you were standing in. Because `~/.claude` exists for every Claude
    Code user, that made ANY repo without its own `.claude/` resolve its root
    to the home directory — writing the config to ~/.claude/roeh.json and
    aiming the trace at ~/docs/decision-trace.md. Found by running roeh on
    roeh, which sits one level below a directory that has both markers.

    So: walk up ONE level at a time, checking every marker at that level.
    Within a level the order is a genuine priority — an explicit config beats
    a repo boundary, which beats a bare .claude/ directory.
    """
    start = os.path.abspath(start)
    probes = (os.path.join(".claude", CONFIG_NAME), ".git", ".claude")
    cur = start
    while True:
        for probe in probes:
            if os.path.exists(os.path.join(cur, probe)):
                return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return start          # no marker anywhere; stay put, never "/"
        cur = parent


# ------------------------------------------------------------------- config

def default_config(root, mode="repo"):
    """Placement defaults differ by mode, and the difference is the point.

    repo  — the trace is a project artifact: versioned, diffable, reviewable,
            backed up with everything else, readable by teammates and CI.
    local — the trace never enters git. For projects whose rationale contains
            material that must not leave the machine (real names of third
            parties, bereavement or crisis content, client confidences). The
            recorded reasoning for that posture is that an append-only file of
            *why* is far more sensitive than the code it explains.
    """
    if mode == "local":
        trace = os.path.join(
            os.path.expanduser("~/.claude/projects"), slug_for(root),
            "memory", "decision-trace.md")
    else:
        trace = "docs/decision-trace.md"
    return {
        "version": SCHEMA_VERSION,
        "mode": mode,
        "trace": trace,
        "profile": ".claude/roeh-profile.md",
        "state": ".claude/" + STATE_NAME,
        "repo": ".",
        "sessions_dir": os.path.join(
            os.path.expanduser("~/.claude/projects"), slug_for(root)),
        # `record: false` is the read-only posture: consult the record, never
        # let automation write to it. Intended for a mature trace that someone
        # has curated by hand and does not want an unattended agent appending
        # to. `roeh append` still works — the line is drawn at automation, not
        # at writing.
        # `block_manual: false` (default): a manual /compact RECORDS then proceeds
        # — it never blocks. The owner found blocking irritating (2026-08-25);
        # set it true to opt into the strict gate that refuses /compact until the
        # record is current.
        "precompact": {"block_manual": False, "nag_auto": True, "record": True},
        "sovereignty": {"local_only": mode == "local",
                        "network_forbidden": True},
        "gate": {"enabled": False},
    }


def config_path(root):
    return os.path.join(root, ".claude", CONFIG_NAME)


def load_config(start=None):
    root = find_project_root(start or os.environ.get("CLAUDE_PROJECT_DIR")
                             or os.getcwd())
    cp = config_path(root)
    cfg = default_config(root)
    if os.path.exists(cp):
        try:
            with open(cp) as f:
                cfg.update(json.load(f))
        except Exception as e:
            die(f"could not parse {cp}: {e}")
        cfg["_configured"] = True
    else:
        cfg["_configured"] = False
    cfg["_root"] = root

    def abspath(p):
        p = os.path.expanduser(p)
        return p if os.path.isabs(p) else os.path.normpath(os.path.join(root, p))

    for key in ("trace", "profile", "state", "repo", "sessions_dir"):
        cfg[key + "_abs"] = abspath(cfg[key])
    return cfg


def load_state(cfg):
    try:
        with open(cfg["state_abs"]) as f:
            return json.load(f)
    except Exception:
        return {"mined_sessions": {}, "last_commit": None, "last_ingest": None}


def save_state(cfg, state):
    os.makedirs(os.path.dirname(cfg["state_abs"]), exist_ok=True)
    with open(cfg["state_abs"], "w") as f:
        json.dump(state, f, indent=2, sort_keys=True)


# ------------------------------------------------------------------- status

def sessions_for(cfg):
    """Top-level transcripts for this project, newest first.

    Subagent transcripts (sessions/<id>/subagents/*.jsonl) are excluded: they
    are the system's own emissions, and mining them for "learnings" is the
    hall-of-mirrors failure this whole apparatus exists to prevent.
    """
    d = cfg["sessions_dir_abs"]
    if not os.path.isdir(d):
        return []
    out = []
    for name in os.listdir(d):
        if not name.endswith(".jsonl"):
            continue
        p = os.path.join(d, name)
        if not os.path.isfile(p):
            continue
        out.append({"id": name[:-6], "path": p,
                    "size": os.path.getsize(p),
                    "mtime": os.path.getmtime(p)})
    return sorted(out, key=lambda s: s["mtime"], reverse=True)


def _is_mined(s, mined):
    """A session is mined iff its transcript's SIZE is unchanged since the mark.

    Transcripts only ever grow, so an equal size means no new content since the
    mark. mtime is deliberately NOT used: it advances on any filesystem touch — a
    cloud-sync rewrite, a backup/restore, reopening the session — which would
    silently un-mine a byte-identical transcript and make the next refresh re-mine
    it for nothing. `cmd_mark` records both mtime and size; only size is trusted.
    (Measured dogfooding: a sync bumped a batch of transcripts' mtimes +7h with
    Delta-size 0, falsely flagging five already-mined sessions as unmined.)
    """
    m = mined.get(s["id"])
    return m is not None and m.get("size") == s["size"]


def status(cfg, active_session=None):
    st = load_state(cfg)
    exists = os.path.exists(cfg["trace_abs"])
    trace_mtime = os.path.getmtime(cfg["trace_abs"]) if exists else 0

    # Commits are measured against the trace's own mtime rather than a stored
    # SHA: the trace is edited by hand as often as by the scribe, and mtime is
    # the one signal that stays honest across both.
    commits = []
    if exists and os.path.isdir(os.path.join(cfg["repo_abs"], ".git")):
        # `--since @N` is inclusive, so a commit made in the SAME second as the
        # trace write came back as unrecorded — a project read as "behind" the
        # instant after it was recorded, which spuriously blocks /compact.
        # Widen the git filter and compare committer timestamps ourselves.
        # File mtimes carry sub-second precision and commit dates do not, so a
        # commit that genuinely preceded the write sorts below it and drops out.
        raw = run(["git", "-C", cfg["repo_abs"], "log", "--all",
                   "--since", f"@{int(trace_mtime) - 1}",
                   "--format=%h\t%ct\t%an\t%s"])
        for line in raw.splitlines():
            parts = line.split("\t", 3)
            if len(parts) != 4:
                continue
            try:
                if float(parts[1]) <= trace_mtime:
                    continue
            except ValueError:
                continue
            commits.append({"sha": parts[0], "author": parts[2],
                            "subject": parts[3]})

    # The currently-active session is excluded from the unmined set. It is an
    # in-progress transcript: it grows every turn, so `roeh mark`ing it never
    # sticks (the next turn's bytes make it unmined again). Counting it made the
    # manual /compact gate UNSATISFIABLE — you cannot record a session before
    # compacting it, because it is still being written. Its rationale is not at
    # risk: the .jsonl persists across compaction and is mined by the NEXT
    # session, where it is no longer active. Found dogfooding roeh's own gate,
    # which wedged /compact on the very session doing the compacting.
    mined = st.get("mined_sessions", {})
    unmined = [s for s in sessions_for(cfg)
               if s["id"] != active_session and not _is_mined(s, mined)]

    # A memory directory is optional — plenty of projects have none.
    mem_dir = os.path.join(os.path.expanduser("~/.claude/projects"),
                           slug_for(cfg["_root"]), "memory")
    mem_changed = []
    if exists and os.path.isdir(mem_dir):
        for name in sorted(os.listdir(mem_dir)):
            if not name.endswith(".md") or name == "decision-trace.md":
                continue
            p = os.path.join(mem_dir, name)
            if os.path.getmtime(p) > trace_mtime:
                mem_changed.append(name)

    return {
        "initialized": cfg["_configured"],
        "trace": cfg["trace_abs"],
        "trace_exists": exists,
        "trace_mtime": trace_mtime,
        "hours_since": (time.time() - trace_mtime) / 3600.0 if exists else None,
        "trace_bytes": os.path.getsize(cfg["trace_abs"]) if exists else 0,
        "trace_lines": sum(1 for _ in open(cfg["trace_abs"], errors="ignore"))
                       if exists else 0,
        "commits": commits,
        "unmined_sessions": [{"id": s["id"], "size": s["size"],
                              "path": s["path"]} for s in unmined],
        "memory_changed": mem_changed,
        "behind": bool(commits or unmined or mem_changed),
        # Surfaced here so the hooks need one call, not two.
        "precompact": cfg.get("precompact", {}),
    }


# -------------------------------------------------------------- subcommands

def cmd_init(args):
    """Initialise, or repair — but never silently orphan a record.

    `--force` used to overwrite the config wholesale. That is a trap: it resets
    mode, trace path and gate to defaults, so a `local`-mode project (chosen
    because its rationale must never enter git) silently became `repo` mode
    pointing at a path with nothing in it — and `roeh status` then said "no
    trace, run /roeh:ingest", inviting a SECOND record while the first sat
    there intact and unreferenced. Two records is the one outcome worse than
    none, because neither is authoritative.

    So --force now MERGES: existing values win, only gaps are filled, and only
    explicit flags change anything. Repointing away from an existing trace is
    refused outright.
    """
    root = find_project_root(os.getcwd())
    cp = config_path(root)
    existing = None
    if os.path.exists(cp):
        try:
            with open(cp) as f:
                existing = json.load(f)
        except Exception as e:
            die(f"could not parse {cp}: {e}")

    # Only an explicit flag chooses a mode; absence is not a vote for "repo".
    mode = ("local" if "--local" in args else
            "repo" if "--repo" in args else
            (existing or {}).get("mode", "repo"))
    cfg = default_config(root, mode)

    if existing is not None:
        if "--force" not in args:
            cur = load_config()
            print(f"already initialised: {cp}")
            print(f"  mode:    {existing.get('mode')}")
            print(f"  trace:   {cur['trace_abs']}"
                  + ("" if os.path.exists(cur["trace_abs"]) else "   (missing)"))
            print(f"  profile: {existing.get('profile')}")
            die("nothing changed. `roeh doctor` checks it; `roeh init --force` "
                "repairs missing keys (merging, never resetting)", 1)
        # Merge: on-disk values win over defaults, so customisation survives.
        merged = dict(cfg)
        merged.update(existing)
        cfg = merged
        cfg["mode"] = mode

    if "--trace" in args:
        cfg["trace"] = args[args.index("--trace") + 1]
    elif existing is not None and mode != existing.get("mode"):
        # A deliberate mode switch implies the default path for the new mode.
        cfg["trace"] = default_config(root, mode)["trace"]

    # --- refuse to strand an existing record ------------------------------
    if existing is not None:
        old = load_config()
        new_trace = os.path.expanduser(cfg["trace"])
        if not os.path.isabs(new_trace):
            new_trace = os.path.normpath(os.path.join(root, new_trace))
        # Sovereignty first: a local->repo flip also repoints, so the generic
        # orphan message would otherwise win and bury the reason that matters.
        if (existing.get("mode") == "local" and mode == "repo"
                and os.path.exists(old["trace_abs"])):
            die("refusing to switch a project with an existing record from "
                "'local' to 'repo' mode.\n"
                "       local mode was chosen because this trace must not enter "
                "git. Flipping it makes the next `git add -A` publish every "
                "rationale in the file — and in a shared repo, republish it to "
                "everyone with read access.\n"
                f"       current record: {old['trace_abs']}\n"
                "       If that is genuinely intended, move the file yourself "
                f"and edit mode in {cp} by hand — deliberately, not as a side "
                "effect of re-running init.")
        if new_trace != old["trace_abs"] and os.path.exists(old["trace_abs"]):
            die(f"refusing to repoint the trace while a record exists.\n"
                f"       current: {old['trace_abs']}\n"
                f"       would be: {new_trace}\n"
                "       The existing record would still be on disk but nothing "
                "would reference it, and `roeh status` would then tell you to "
                "ingest — building a second, competing history.\n"
                "       Move the file yourself first, then re-run. roeh will "
                "not relocate an append-only record on your behalf.")

    cfg["version"] = SCHEMA_VERSION
    os.makedirs(os.path.dirname(cp), exist_ok=True)
    with open(cp, "w") as f:
        json.dump(cfg, f, indent=2, sort_keys=True)

    if existing is None:
        print(f"initialised {cp}  (mode: {mode})")
    else:
        changed = [k for k in cfg if existing.get(k) != cfg[k]]
        print(f"repaired {cp}"
              + (f"  changed: {', '.join(changed)}" if changed else
                 "  (nothing needed changing)"))


def cmd_config(args):
    cfg = load_config()
    # Built with dict.update rather than the `|` union operator, which is 3.9+.
    # A SyntaxError is raised at PARSE time, so it would fire before the version
    # check above could report it — and inside a hook that surfaces as silence
    # at the exact moment the record matters. Keep this file parseable by the
    # oldest Python we claim to support.
    out = {k: v for k, v in cfg.items() if not k.startswith("_")}
    out.update({"root": cfg["_root"], "configured": cfg["_configured"]})
    print(json.dumps(out, indent=2, sort_keys=True))


def opt_value(args, name, default=None):
    """Read `--name VALUE` (two tokens) from an argv list."""
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def cmd_status(args):
    cfg = load_config()
    # The active session is passed by the hooks (which read it from the event
    # JSON) so `status` can exclude it — see status(). CLAUDE_SESSION_ID is a
    # fallback for a bare `roeh status` run inside a live session.
    active = opt_value(args, "--session") or os.environ.get("CLAUDE_SESSION_ID")
    s = status(cfg, active_session=active)
    if "--json" in args:
        print(json.dumps(s, indent=2, sort_keys=True))
        return
    if not s["initialized"]:
        # Distinguish "never set up" from "set up but not yet ingested". Both
        # used to point at /roeh:ingest, which sends a new user to the second
        # step and leaves them wondering why nothing resolves.
        print("roeh is not set up in this project — run /roeh:init first\n"
              f"  (it would default to: {s['trace']})")
        return
    if not s["trace_exists"]:
        print(f"no trace at {s['trace']} — run /roeh:ingest to build one")
        return
    print(f"trace: {s['trace']}")
    print(f"       {s['trace_lines']} lines / {s['trace_bytes']//1024}KB, "
          f"written {s['hours_since']:.1f}h ago")
    if not s["behind"]:
        print("status: current — no commits, sessions or memory changes since")
        return
    if s["commits"]:
        print(f"behind: {len(s['commits'])} commit(s) unrecorded")
        for c in s["commits"][:15]:
            print(f"        - {c['sha']} {c['subject']}")
    if s["unmined_sessions"]:
        print(f"behind: {len(s['unmined_sessions'])} unmined session(s)")
    if s["memory_changed"]:
        print(f"behind: {len(s['memory_changed'])} memory file(s) changed")


def cmd_append(args):
    """The ONLY write path to the trace, and it can only ever append.

    The original design forbade the scribe from writing at all, on the
    reasoning that "an agent with write access to an append-only file is one
    bad edit from destroying the record it exists to protect." That reasoning
    is about Write/Edit, which can truncate. This opens the file in 'a' mode
    and never seeks: rewriting an existing entry is not expressible through
    this interface, so the guarantee is structural rather than honour-system.
    """
    cfg = load_config()
    if not os.path.exists(cfg["trace_abs"]):
        die(f"no trace at {cfg['trace_abs']} — run /roeh:ingest first")
    text = sys.stdin.read() if ("-" in args or not args) else open(args[0]).read()
    if not text.strip():
        die("refusing to append empty content")
    before = os.path.getsize(cfg["trace_abs"])
    # Check the final byte rather than reading the file: the trace is the one
    # artifact guaranteed to grow without bound, and this runs on every append.
    # Lock + fsync like `record`: an unlocked append that lands between record's read-tail and its
    # write would leave record's freshly-computed chain pointing at the wrong predecessor. Both write
    # paths take the SAME advisory lock so they exclude each other (review P1-4). The trailing-newline
    # check runs UNDER the lock too — a concurrent record between an early check and the lock could
    # otherwise make this insert a spurious blank line (review #6).
    import fcntl
    with open(cfg["trace_abs"], "a") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        try:
            needs_nl = False
            if os.fstat(f.fileno()).st_size:
                with open(cfg["trace_abs"], "rb") as rf:
                    rf.seek(-1, os.SEEK_END)
                    needs_nl = rf.read(1) != b"\n"
            if needs_nl:
                f.write("\n")
            f.write(text if text.endswith("\n") else text + "\n")
            f.flush()
            os.fsync(f.fileno())
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
    after = os.path.getsize(cfg["trace_abs"])
    print(f"appended {after - before} bytes to {cfg['trace_abs']}")


def _load_roeh_map():
    """Import the read-path core (the parser/liveness/chain authority) from this same bin dir.
    Lazy: only `record` (and, later, map/scope) need it, so hooks calling `status` don't pay for it."""
    here = os.path.dirname(os.path.abspath(__file__))
    if here not in sys.path:
        sys.path.insert(0, here)
    import roeh_map
    return roeh_map


_UNSAFE = ("<!--", "-->", "\n", "\r")


def _reject_unsafe(value, what, extra=()):
    """A field value comes from untrusted JSON and is interpolated into the authoritative log. Reject
    any sequence that could FORGE the machine comment (`<!-- -->`) or break the entry into fake
    heads/edges/headings (a newline). The reader binds the FIRST `<!-- roeh -->` in a block, so an
    injected comment in the prose would silently become the entry's identity (review P0-1)."""
    for bad in _UNSAFE + tuple(extra):
        if bad in value:
            die("%s contains an illegal sequence %r — it would corrupt or forge the record" % (what, bad))


def _idlist(v):
    """A relation/cite field may arrive as a JSON list or a comma string; normalise, dedupe, order."""
    if v is None:
        return []
    if isinstance(v, str):
        v = v.split(",")
    out = []
    for x in v:
        x = str(x).strip()
        if x and x not in out:
            out.append(x)
    return out


def _content_id(date_str, tag, lead):
    """The entry's 64-bit content id (impl-write-path §3.1): sha256(NFC(date) · tag · NFC(lead))[:16],
    canonicalised (NFC + collapsed whitespace) so two implementations agree. Deterministic and
    decentralised — a producer can compute a TARGET's id (via `roeh id`) to reference it in a
    Supersedes:/Augments: edge without capturing the target's `record` output; the target must still be
    recorded before the edge resolves (record refuses a dangling target). Immutable once written."""
    import hashlib
    import unicodedata

    def canon(s):
        return unicodedata.normalize("NFC", re.sub(r"\s+", " ", s.strip()))

    payload = "\x00".join([canon(date_str), tag.upper(), canon(lead)])
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]


def _format_record(tag, lead, req, edges, cites, eid, atomic, d, hints, chain):
    """The hybrid entry the reader parses: `[TAG] lead.` + WHY/REJECTED/GATES, visible relation
    lines, and a trailing `<!-- roeh … -->` bookkeeping comment. Continuation lines are indented so
    none can be mistaken for a new entry head or a heading."""
    parts = []
    for label, key in (("WHY", "why"), ("REJECTED", "rejected"), ("GATES", "gates")):
        val = (req.get(key) or "").strip()
        if val:
            parts.append("%s: %s" % (label, val))
    head = "- **[%s] %s.**" % (tag, lead) + ((" " + " ".join(parts)) if parts else "")
    lines = [head]
    for label, vals in (("Supersedes", edges["supersedes"]), ("Augments", edges["augments"]),
                        ("Conflicts", edges["conflicts"]), ("Cites", cites)):
        if vals:
            lines.append("  %s: %s" % (label, ", ".join(vals)))
    meta = "id=%s atomic=%s date=%s chain=%s" % (eid, "true" if atomic else "false", d, chain)
    if hints:
        meta += " topic-hint=" + ", ".join(hints)
    lines.append("  <!-- roeh %s -->" % meta)
    return "\n".join(lines) + "\n"


def cmd_record(args):
    """The structured, transactional write path — the producer contract (docs/design/impl-write-path.md).

    Reads a JSON entry on stdin, assigns a content-derived id, validates its edges against the
    reader, computes the tamper-evidence chain, and appends ONE complete record under an exclusive
    lock with fsync. `append` stays the raw primitive. The clean-ingest wiring (build step 3) moves
    the scribe and ingest onto THIS so id / chain / format / edge-validation are enforced at creation
    rather than hand-authored and hoped for; until then the producers still use `append` and a v3
    trace is created by a clean re-ingest, not by converting the legacy one (clean-start-always).
    The reader defines the schema; this refuses what the reader would merely tolerate."""
    import fcntl
    from datetime import date as _date

    cfg = load_config()
    trace = cfg["trace_abs"]
    if not os.path.exists(trace):
        die(f"no trace at {trace} — run /roeh:ingest first")
    rm = _load_roeh_map()
    try:
        req = json.load(sys.stdin)
    except Exception as e:
        die(f"roeh record reads one JSON entry on stdin ({e})")
    if not isinstance(req, dict):
        die("roeh record reads one JSON OBJECT on stdin (got %s)" % type(req).__name__)
    for k in ("tag", "lead", "why", "rejected", "gates", "date"):
        if req.get(k) is not None and not isinstance(req[k], str):
            die(f"{k} must be a string")

    tag = (req.get("tag") or "").strip().upper()
    lead = (req.get("lead") or "").strip()
    if not re.match(r"^[A-Z][A-Z0-9-]{1,18}$", tag):
        die(f"bad tag {tag!r} — must match [A-Z][A-Z0-9-]{{1,18}}")
    if not lead:
        die("lead is required — the one atomic claim")
    if ". " in lead:
        die("lead must be a single sentence (no '. ' inside): the reader splits the lead on it")
    if len(lead) > 90:
        die("lead must be ≤90 chars — the reader truncates the display there; keep it one claim")

    # Every prose field is interpolated into the log; sanitise before it can forge/break the entry.
    for name, val in (("lead", lead), ("why", str(req.get("why") or "")),
                      ("rejected", str(req.get("rejected") or "")), ("gates", str(req.get("gates") or ""))):
        _reject_unsafe(val, name)

    d = (req.get("date") or _date.today().isoformat()).strip()
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", d):
        die(f"date {d!r} must be YYYY-MM-DD")
    try:
        _date.fromisoformat(d)
    except ValueError:
        die(f"date {d!r} is not a real calendar date")

    atomic = req.get("atomic", True)
    if not isinstance(atomic, bool):
        die("atomic must be a JSON boolean (true or false)")

    edges = {k: _idlist(req.get(k)) for k in ("supersedes", "augments", "conflicts")}
    # A comma in a cite must be caught on the RAW input, BEFORE _idlist splits a string-form
    # cite on commas — that split turns one comma-bearing cite into two silent fragments and
    # hides the very mangle this guards against (code-review). Cites are comma-joined into the
    # visible `Cites:` line, so a comma inside one is never valid; pass multiple cites as a list.
    _raw_cites = req.get("cites")
    if ((isinstance(_raw_cites, str) and "," in _raw_cites)
            or (isinstance(_raw_cites, list) and any("," in str(x) for x in _raw_cites))):
        die("a cite contains a comma — cites are comma-separated in the visible Cites: line, so "
            "a comma inside one would split it; use ';' or ' — ', and pass multiple cites as a list")
    cites = _idlist(_raw_cites)
    hints = _idlist(req.get("topic_hint"))
    for name in ("supersedes", "augments", "conflicts"):
        for t in edges[name]:
            _reject_unsafe(t, f"{name} id {t!r}", extra=(",",))
    for c in cites:
        _reject_unsafe(c, f"cite {c!r}")
    for h in hints:
        # `=` too: topic-hint is the ONE list that lands in the machine comment, where ` word=` would
        # forge a meta key (review P0-1/#5). Edges/cites live in visible field lines, so `,` suffices there.
        _reject_unsafe(h, f"topic-hint {h!r}", extra=(",", "="))

    # The whole read→validate→chain→append is done under an exclusive lock so two concurrent
    # writers cannot both chain off the same tail (the second's chain would silently lie). append
    # is O_APPEND (bytes don't interleave), but the CHAIN needs the read+write to be atomic as a unit.
    with open(trace, "r+", encoding="utf-8") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        try:
            f.seek(0)
            cur = f.read()
            entries = rm.parse_entries(cur)
            by_id = {e.id: e for e in entries}

            # Mechanical facts → refuse (not the reader's job to tolerate what the writer can prevent).
            for name in ("supersedes", "augments", "conflicts"):
                for t in edges[name]:
                    if t not in by_id:
                        die(f"{name} target {t} does not exist in the trace")
            if tag in ("REVERSAL", "CORRECTION") and not edges["supersedes"] and not edges["augments"]:
                die(f"{tag} needs a typed Supersedes:/Augments: edge — "
                    "an overturn with no edge reads as prose-only (⇒ UNCERTAIN)")

            # id = 64-bit content hash (immutable once written). A collision is treated as a duplicate
            # and refused below — at 64 bits a different-content collision is ~2^-64, so no salt path.
            eid = _content_id(d, tag, lead)
            # Collision → duplicate → refuse. Scan the RAW text, not `by_id`: a pre-existing duplicate
            # id is disambiguated by the reader to `id~dupL#`, so it would not appear in `by_id` in its
            # bare form and the collision would slip through (review P2-5).
            if re.search(r"(?<![\w-])id=" + re.escape(eid) + r"(?![0-9a-f])", cur):
                die(f"duplicate: id {eid} is already in the trace "
                    "(same date+tag+lead) — vary the lead if this is a genuinely different decision")

            # Chain = fold chain_link through EVERY existing id (matching _expected_chains), then this
            # id. Reading the tail's stored chain is not enough: a legacy tail has none.
            prev = ""
            for e in entries:
                prev = rm.chain_link(prev, e.id)
            chain = rm.chain_link(prev, eid)

            block = _format_record(tag, lead, req, edges, cites, eid, atomic, d, hints, chain)
            sep = "" if (not cur or cur.endswith("\n")) else "\n"

            # (a) The formatted entry MUST round-trip through the reader to exactly what we intended —
            # a belt-and-braces catch for anything that slipped past _reject_unsafe (review P0-1). If it
            # does not parse back to ONE entry carrying our id/edges/meta, a field forged the record.
            rt = rm.parse_entries(block)
            if not (len(rt) == 1 and rt[0].id == eid and rt[0].tag == tag and rt[0].date == d
                    and bool(rt[0].atomic) == atomic and rt[0].chain == chain
                    and rt[0].supersedes == edges["supersedes"] and rt[0].augments == edges["augments"]
                    and rt[0].conflicts == edges["conflicts"] and rt[0].cites == cites
                    and rt[0].topic_hint == hints):
                die("refusing: the formatted entry does not round-trip through the reader "
                    "(a field value would corrupt or forge the record)")

            # (b) The append MUST NOT introduce new UNCERTAIN — competing successors with no conflict
            # link, a dropped augment across a supersession, etc. are the writer's to prevent, not the
            # reader's to tolerate (review P1-3). Diff liveness across the append; refuse on any newly
            # uncertain entry, quoting the reader's own reason.
            before, _ = rm.compute_liveness(entries)
            after, areason = rm.compute_liveness(rm.parse_entries(cur + sep + block))
            refuse, warn = [], []
            for i in after:
                if after[i] == "uncertain" and before.get(i) != "uncertain":
                    # "non-atomic entry superseded" is a property of the TARGET — a legacy or
                    # append-authored entry with no atomic stamp — not a fault the new record can fix
                    # (it cannot retro-stamp the old entry). Warn and allow, or `record` could never
                    # supersede any pre-v3 entry (review #1). Everything else — competing successors,
                    # a dropped augment, a dangling/prose-only edge — the writer MUST prevent.
                    (warn if "non-atomic entry superseded" in areason[i] else refuse).append(areason[i])
            if refuse:
                die("refusing: this record would introduce UNCERTAIN — " + "; ".join(sorted(set(refuse))))
            for w in sorted(set(warn)):
                sys.stderr.write("warning: " + w + "\n")

            f.seek(0, os.SEEK_END)
            f.write(sep + block)              # one write of one complete record
            f.flush()
            os.fsync(f.fileno())              # durable before the lock releases
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
    print(eid)


def cmd_id(args):
    """Compute the content-id for an entry WITHOUT writing it — so a producer can pre-compute a
    TARGET's id to put in a Supersedes:/Augments: edge. NOTE: `record` still requires the target to
    already be in the trace (it refuses a dangling edge), so record the target BEFORE its superseder —
    natural in a chronological ingest. `roeh id` just names the id without capturing `record`'s stdout.
    Reads JSON {tag, lead, date?} on stdin (date defaults to today); prints the 16-hex id — the exact
    id `record` will assign, so a pre-computed reference resolves once the target is recorded."""
    from datetime import date as _date
    try:
        req = json.load(sys.stdin)
    except Exception as e:
        die(f"roeh id reads one JSON object {{tag, lead, date?}} on stdin ({e})")
    if not isinstance(req, dict):
        die("roeh id reads one JSON OBJECT on stdin")
    tag = (req.get("tag") or "").strip().upper()
    lead = (req.get("lead") or "").strip()
    if not re.match(r"^[A-Z][A-Z0-9-]{1,18}$", tag):
        die(f"bad tag {tag!r} — must match [A-Z][A-Z0-9-]{{1,18}}")
    if not lead:
        die("lead is required — the one atomic claim")
    d = (req.get("date") or _date.today().isoformat()).strip()
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", d):
        die(f"date {d!r} must be YYYY-MM-DD")
    print(_content_id(d, tag, lead))


def cmd_sessions(args):
    cfg = load_config()
    st = load_state(cfg)
    mined = st.get("mined_sessions", {})
    only_unmined = "--unmined" in args
    rows = []
    for s in sessions_for(cfg):
        is_mined = _is_mined(s, mined)
        if only_unmined and is_mined:
            continue
        rows.append((s["id"], s["size"], "mined" if is_mined else "UNMINED",
                     s["path"]))
    if "--json" in args:
        print(json.dumps([{"id": r[0], "size": r[1], "state": r[2],
                           "path": r[3]} for r in rows], indent=2))
        return
    for r in rows:
        print(f"{r[2]:8} {r[1]//1024:>7}KB  {r[0]}  {r[3]}")


def cmd_mark(args):
    """Record that a session has been folded in, so refresh stays incremental."""
    cfg = load_config()
    st = load_state(cfg)
    for sid in [a for a in args if not a.startswith("-")]:
        match = [s for s in sessions_for(cfg) if s["id"].startswith(sid)]
        if not match:
            die(f"no session matching {sid}")
        s = match[0]
        st.setdefault("mined_sessions", {})[s["id"]] = {
            "mtime": s["mtime"], "size": s["size"], "at": time.time()}
        print(f"marked {s['id']} as mined")
    save_state(cfg, st)


def cmd_slug(args):
    print(slug_for(args[0] if args else os.getcwd()))


INGEST_STALE_AFTER = 6 * 3600  # a run quiet this long is abandoned, not running

# ── v3 read path: map / read / scope / verify (supersede index/chapters; impl-read-path.md) ──
# These wire the pure reader core in bin/roeh_map.py — the single tokenizer, the parser, mechanical
# liveness, the collapsing map projection, the per-region Bloom, the recursive read, and the
# projection-id freshness gate — into the CLI. The log is the authority; the map + bloom sidecar are
# a DERIVED cache the reader REFUSES when stale (`roeh verify`). Exit codes ARE the contract (§4):
# map 0/3, read 0/4, scope 0, verify 0/6/7. `index`/`chapters` are gone — a grep ladder cannot find
# what you do not know to look for, and two live retrieval stories is one too many.


def _read_topic_map(cfg):
    """The optional, non-authoritative semantic side-map (`<trace>-topics.md`); '' if absent. Its
    hash is a projection-id input, so adding or editing it correctly ages the map (impl §2.0)."""
    p = cfg["trace_abs"].rsplit(".", 1)[0] + "-topics.md"
    try:
        with open(p, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def _repo_head(cfg):
    """Current repo HEAD — a projection-id input, because map generation consults git for cite
    path-provenance (impl §2.0). Ask `rev-parse` directly rather than probing for a `.git`
    DIRECTORY, so a linked worktree or submodule (where `.git` is a FILE) is handled too; `run`
    returns '' for a non-repo, so a non-git project still maps. map and verify call this
    identically, so under-detection only under-ages the map — never a spurious freshness flip."""
    return run(["git", "-C", cfg["repo_abs"], "rev-parse", "HEAD"])


def _positional(args):
    """The non-flag arguments — drops the known two-token flags (--budget/--dormancy/--as-of) AND
    their values, so a flag's argument never leaks into a query or a selector (the bug where
    `scope "auth" --as-of 2026-01-01` folded `2026` into the query and inflated the drill set)."""
    twotoken = {"--budget", "--dormancy", "--as-of"}
    out, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a in twotoken:
            skip = True
        elif not a.startswith("--"):
            out.append(a)
    return out


def _map_opts(args):
    """Shared projection knobs. Defaults match bin/roeh_map (budget 1500 tokens, dormancy 180d,
    as-of today). They are part of the projection context, so `verify` reuses the STORED ones. A
    bad value is a usage error (exit 1), not a raw traceback or a silently-misclassifying map."""
    def _int(flag, default):
        v = opt_value(args, flag, default)
        try:
            return int(v)
        except (TypeError, ValueError):
            die(f"{flag} must be an integer, got {v!r}")
    as_of = opt_value(args, "--as-of")
    if as_of is not None and not re.match(r"^\d{4}-\d{2}-\d{2}$", as_of):
        die(f"--as-of must be YYYY-MM-DD, got {as_of!r}")
    return _int("--budget", 1500), _int("--dormancy", 180), as_of


def cmd_map(args):
    """Fold the log into the root control plane + bloom sidecar, stamped with a projection-id.

    `<trace>-map.md` (the human-readable CP: preamble / live / ledger / regions) and
    `<trace>-bloom.json` (per-region literal index + the projection context) are the only
    materialized artifacts; every nested read is recomputed from the log on demand under the SAME
    projection-id. Exit 0 ok; 3 if the root cannot fit the budget even after full hierarchization
    (a bug signal — the budget loop is meant to make that unreachable)."""
    import base64
    from datetime import date as _date
    cfg = load_config()
    trace = cfg["trace_abs"]
    if not os.path.exists(trace):
        die(f"no trace at {trace} — run /roeh:ingest first")
    rm = _load_roeh_map()
    text = open(trace, encoding="utf-8").read()
    budget, D, as_of = _map_opts(args)
    if not as_of:
        as_of = _date.today().isoformat()
    m, k = rm.BLOOM_M, rm.BLOOM_K
    model = rm.build_map(text, budget, D, as_of, frozenset(),
                         _read_topic_map(cfg), _repo_head(cfg))
    map_path = trace.rsplit(".", 1)[0] + "-map.md"
    with open(map_path, "w", encoding="utf-8") as f:
        f.write(model.rendered + "\n")
    blooms = {}
    for key, bl in model.blooms.items():
        d = dict(bl)
        d["bloom"] = base64.b64encode(bl["bloom"].to_bytes((bl["m"] + 7) // 8, "big")).decode("ascii")
        blooms[key] = d
    sidecar = trace.rsplit(".", 1)[0] + "-bloom.json"
    with open(sidecar, "w", encoding="utf-8") as f:
        json.dump({"projection_id": model.projection_id,
                   "params": {"budget": budget, "D": D, "as_of": as_of, "m": m, "k": k},
                   "blooms": blooms}, f, indent=2, sort_keys=True)
    print("%s\n  %d lines / %dKB · projection-id %s · %s" % (
        map_path, model.rendered.count("\n") + 1, len(model.rendered) // 1024,
        model.projection_id, "fits" if model.fits else "OVER BUDGET after hierarchization"))
    if not model.fits:
        sys.exit(3)


def cmd_read(args):
    """Pull one control plane or entry EXACTLY: a region, a `region/N` segment, an entry `id`, a
    `§N` section (LAST-wins — append-only supersedes by appending), `@ledger`, or a fan-out
    `group:N`. Sub-reads inherit the map's projection context. Exit 0 found — a recovered entry
    with a dangling cite is still 0, carrying an UNVERIFIED / UNRESOLVED-PATH marker, because you
    fail closed on the CLAIM that needs the broken provenance, never on retrieval of an intact
    entry; 4 no such selector."""
    cfg = load_config()
    trace = cfg["trace_abs"]
    if not os.path.exists(trace):
        die(f"no trace at {trace}")
    pos = _positional(args)
    if not pos:
        die("usage: roeh read <region | region/N | <id> | §N | @ledger | group:N>")
    rm = _load_roeh_map()
    text = open(trace, encoding="utf-8").read()
    budget, D, as_of = _map_opts(args)

    def resolve_cite(c):
        """A cite resolves if its path component exists in the repo. A bare SHA / id (no path
        separator) is not a path, so it is never flagged UNRESOLVED-PATH here."""
        path = c.split("@", 1)[0].split(":", 1)[0].strip()
        if not path or ("/" not in path and "." not in path):
            return True
        return os.path.exists(os.path.join(cfg["repo_abs"], path))

    res = rm.read(text, pos[0], D=D, as_of=(as_of or None),
                  budget_tokens=budget, resolve_cite=resolve_cite)
    print(res.rendered)
    if res.kind == "unreadable":
        sys.exit(4)


def _load_blooms(cfg, rm, text, budget, D, as_of):
    """Prefer the materialized sidecar, so the stored bitsets are actually READ BACK — a bitset
    written but never read would be the dead-field bug this project is named after, and storing
    the filter is what buys O(query) scope on a large trace. Recompute from the log only when the
    sidecar is missing or stale (projection-id mismatch)."""
    import base64
    sidecar = cfg["trace_abs"].rsplit(".", 1)[0] + "-bloom.json"
    if os.path.exists(sidecar):
        meta = json.load(open(sidecar, encoding="utf-8"))
        p = meta.get("params", {})
        fresh = rm.projection_id(text, p.get("budget", 1500), p.get("D", 180), p.get("as_of"),
                                 p.get("m", rm.BLOOM_M), p.get("k", rm.BLOOM_K),
                                 _read_topic_map(cfg), _repo_head(cfg)) == meta.get("projection_id")
        if fresh:
            blooms = {}
            for key, bl in meta["blooms"].items():
                d = dict(bl)
                d["bloom"] = int.from_bytes(base64.b64decode(bl["bloom"]), "big")
                blooms[key] = d
            return blooms, "sidecar (fresh)"
    model = rm.build_map(text, budget, D, (as_of or None), frozenset(),
                         _read_topic_map(cfg), _repo_head(cfg))
    return model.blooms, "recomputed (sidecar missing or stale — run `roeh map`)"


def cmd_scope(args):
    """Debug the retrieval frontier for a query: its ≥3-char literal tokens and the mechanically
    complete set of regions whose Bloom matches any of them (the MUST-drill set — no false
    negatives), complete to the REGION boundary: which segment/entry inside a drilled region
    holds the token is the caller's read, NOT narrowed here (recursive-to-leaf drill is designed,
    not yet wired — see retrieval-at-scale.md §5.3 shipped-status).
    Uses the IDENTICAL tokenizer as the map, which is what the guarantee rests on.
    Reads the materialized bloom sidecar when fresh; recomputes otherwise. Exit 0."""
    cfg = load_config()
    trace = cfg["trace_abs"]
    if not os.path.exists(trace):
        die(f"no trace at {trace}")
    q = " ".join(_positional(args))
    if not q.strip():
        die('usage: roeh scope "<query>"')
    rm = _load_roeh_map()
    text = open(trace, encoding="utf-8").read()
    budget, D, as_of = _map_opts(args)
    blooms, src = _load_blooms(cfg, rm, text, budget, D, as_of)
    hits = rm.scope_literal(q, blooms)
    toks = sorted(rm.tokenize(q))
    print("query tokens (≥3c): " + (", ".join(toks) or "(none)"))
    print("bloom source: " + src)
    print("bloom drill set (%d region(s)): %s" % (len(hits), ", ".join(sorted(hits)) or "(none)"))


def cmd_verify(args):
    """Freshness + integrity gate for the read path. 0 fresh+intact; 6 stale (a projection input —
    the exact log bytes, the topic side-map, or repo HEAD — moved since `roeh map`, so the cache no
    longer matches the authority); 7 tamper (the entry chain does not recompute). Freshness hashes
    the LOG BYTES, not git HEAD, so an uncommitted EOF append is correctly seen as stale."""
    cfg = load_config()
    trace = cfg["trace_abs"]
    if not os.path.exists(trace):
        die(f"no trace at {trace}")
    rm = _load_roeh_map()
    text = open(trace, encoding="utf-8").read()
    code, msg = rm.verify_chain(rm.parse_entries(text))
    if code == 7:
        print("tamper: " + msg)
        sys.exit(7)
    sidecar = trace.rsplit(".", 1)[0] + "-bloom.json"
    if not os.path.exists(sidecar):
        print("stale: no map materialized — run `roeh map`")
        sys.exit(6)
    meta = json.load(open(sidecar, encoding="utf-8"))
    p = meta.get("params", {})
    cur = rm.projection_id(text, p.get("budget", 1500), p.get("D", 180), p.get("as_of"),
                           p.get("m", rm.BLOOM_M), p.get("k", rm.BLOOM_K),
                           _read_topic_map(cfg), _repo_head(cfg))
    if cur != meta.get("projection_id"):
        print("stale: projection inputs changed since the map was built — run `roeh map`")
        sys.exit(6)
    print("fresh + intact")


def cmd_ingest(args):
    """Ingest lifecycle. An ingest that dies halfway leaves a trace that reads
    exactly like a finished one — same sections, same voice, silently missing
    whole chapters of history. The oracle would then answer "not recorded" for
    decisions that ARE recorded, just not yet mined, and it would sound just as
    confident as when it is right.

    So an ingest declares its plan up front and marks chapters off as they land.
    That makes the difference between "complete", "interrupted at chapter 4 of
    7", and "never run" a fact rather than a guess.

      roeh ingest status [--json]
      roeh ingest begin --floor <date> --plan c1,c2,c3
      roeh ingest done <chapter-id>
      roeh ingest end
      roeh ingest abandon
    """
    cfg = load_config()
    st = load_state(cfg)
    ing = st.get("ingest") or {}
    sub = args[0] if args else "status"

    def val(flag, default=None):
        return args[args.index(flag) + 1] if flag in args else default

    if sub == "begin":
        plan = [p.strip() for p in (val("--plan") or "").split(",") if p.strip()]
        st["ingest"] = {"state": "partial", "floor": val("--floor"),
                        "plan": plan, "done": [], "started": time.time(),
                        "finished": None}
        save_state(cfg, st)
        print(f"ingest begun: {len(plan)} planned unit(s), floor {val('--floor')}")
        return

    if sub == "done":
        if not ing:
            die("no ingest in progress — `roeh ingest begin` first")
        for cid in [a for a in args[1:] if not a.startswith("-")]:
            if cid not in ing["done"]:
                ing["done"].append(cid)
        st["ingest"] = ing
        save_state(cfg, st)
        print(f"{len(ing['done'])}/{len(ing['plan'])} complete")
        return

    if sub == "end":
        if not ing:
            die("no ingest in progress")
        missing = [p for p in ing["plan"] if p not in ing["done"]]
        if missing and "--force" not in args:
            die(f"refusing to close an ingest with {len(missing)} unfinished "
                f"unit(s): {', '.join(missing)}\n"
                "       finish them, or `roeh ingest end --force` to record it "
                "as partial (the gap will be reported by `roeh doctor`)")
        ing["state"] = "complete" if not missing else "partial-closed"
        ing["finished"] = time.time()
        ing["missing"] = missing
        st["ingest"] = ing
        st["last_ingest"] = ing["finished"]
        save_state(cfg, st)
        print(f"ingest closed: {ing['state']}"
              + (f" ({len(missing)} never completed)" if missing else ""))
        return

    if sub == "abandon":
        st["ingest"] = None
        save_state(cfg, st)
        print("ingest state cleared — the trace itself is untouched")
        return

    # --- status ----------------------------------------------------------
    trace_exists = os.path.exists(cfg["trace_abs"])
    if not ing:
        state = "none" if not trace_exists else "unknown"
    else:
        state = ing.get("state", "partial")
        if state == "partial":
            quiet = time.time() - ing.get("started", 0)
            state = "abandoned" if quiet > INGEST_STALE_AFTER else "running"
    result = {"state": state, "trace_exists": trace_exists,
              "floor": ing.get("floor"), "plan": ing.get("plan", []),
              "done": ing.get("done", []),
              "missing": [p for p in ing.get("plan", []) if p not in ing.get("done", [])],
              "started": ing.get("started"), "finished": ing.get("finished")}
    if "--json" in args:
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    print(f"ingest: {state}")
    if state == "unknown":
        print("  a trace exists but no ingest was ever recorded — it predates "
              "lifecycle tracking, or was built by hand")
    if result["plan"]:
        print(f"  {len(result['done'])}/{len(result['plan'])} units"
              + (f"  missing: {', '.join(result['missing'])}" if result["missing"] else ""))
    if result["floor"]:
        print(f"  floor: {result['floor']}")


def plugin_version():
    """Version of the roeh that is actually running.

    Resolved from this script's own location rather than CLAUDE_PLUGIN_ROOT, so
    it is still correct when invoked directly from a clone or a test.
    """
    p = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                     ".claude-plugin", "plugin.json")
    try:
        with open(p) as f:
            return json.load(f).get("version", "unknown")
    except Exception:
        return "unknown"


# Sections the agents structurally depend on. The oracle's degradation ladder
# reads §0/§1/§5 in full at ANY trace size and always reads the staleness
# ledger, so their absence is not cosmetic — it silently removes the guarantee.
# §0 (orientation) and §5 (resume state — read first after a compaction) are required of BOTH the
# legacy §0–§5 layout AND a v3 flat-log trace. §1/§3/§4 are legacy-only: in a v3 trace the derived
# `roeh map` holds the ledger/liveness/regions and the profile holds the principles digest, so they
# are not hand-filled sections (impl-write-path §3 flat-log decision).
REQUIRED_SECTIONS = ["0", "5"]


def cmd_doctor(args):
    """Check that this project's roeh artifacts match the running plugin.

    `claude plugin update` updates the PLUGIN. Nothing in the harness migrates a
    project's config, trace or profile when the plugin's expectations move — and
    a half-migrated record is the worst failure available to a tool whose entire
    premise is that the record can be trusted. This is that missing check.

    --fix applies only the safe repairs: config keys, schema version, gitignore.
    It never touches the trace. Repairing an append-only record is a
    contradiction in terms.
    """
    fix = "--fix" in args
    cfg = load_config()
    root = cfg["_root"]
    findings = []          # (level, message, hint)

    def ok(m):    findings.append(("OK", m, None))
    def warn(m, h=None):  findings.append(("WARN", m, h))
    def fail(m, h=None):  findings.append(("FAIL", m, h))

    pv = plugin_version()
    ok(f"plugin roeh {pv}")

    # --- config -----------------------------------------------------------
    if not cfg["_configured"]:
        fail(f"no config at {config_path(root)}", "run /roeh:init")
        report(findings, fix)
        return
    ok(f"config {config_path(root)}")

    found_v = cfg.get("version")
    if found_v == SCHEMA_VERSION:
        ok(f"config schema v{found_v} matches plugin")
    elif isinstance(found_v, int) and found_v < SCHEMA_VERSION:
        warn(f"config schema v{found_v}, plugin expects v{SCHEMA_VERSION}",
             "roeh doctor --fix")
    else:
        fail(f"config schema v{found_v} is NEWER than this plugin "
             f"(v{SCHEMA_VERSION}) — the plugin is behind, not the config",
             "claude plugin update roeh")

    defaults = default_config(root, cfg.get("mode", "repo"))
    on_disk = json.load(open(config_path(root)))
    missing = [k for k in defaults if k not in on_disk]
    unknown = [k for k in on_disk if k not in defaults]
    if missing:
        warn(f"config missing key(s) added by a newer roeh: {', '.join(missing)}",
             "roeh doctor --fix")
    if unknown:
        warn(f"config has unrecognised key(s): {', '.join(unknown)}",
             "typo, or left over from an older roeh — remove by hand")
    if not missing and not unknown:
        ok("config keys complete")

    # --- the record -------------------------------------------------------
    if not os.path.exists(cfg["trace_abs"]):
        fail(f"no trace at {cfg['trace_abs']}", "run /roeh:ingest")
    else:
        text = open(cfg["trace_abs"], errors="ignore").read()
        lines = text.count("\n") + 1
        kb = len(text.encode()) // 1024
        ok(f"trace {lines} lines / {kb}KB")

        absent = [s for s in REQUIRED_SECTIONS
                  if not re.search(rf"^#{{1,6}}\s*(?:§\s*)?{s}\b", text, re.M)]
        if absent:
            fail("trace is missing section(s) the agents depend on: "
                 + ", ".join("§" + s for s in absent),
                 "§0 (orientation) and §5 (resume state, read first after a "
                 "compaction) are required in every trace; add the heading "
                 "(append — never restructure the file)")
        else:
            ok("trace has all required sections")

        if not re.search(r"staleness|contradiction", text, re.I):
            warn("no contradictions/staleness ledger found in the trace",
                 "the oracle reads it in full at every size; without one it "
                 "cannot tell you what the record already knows is unreliable")

        # Past this size the oracle no longer reads the whole file; it reads the
        # derived map (preamble/live/ledger in full) then drills. So past the
        # threshold the map is not optional — without it the oracle greps, and
        # grepping cannot find what it does not know to look for.
        mapf = cfg["trace_abs"].rsplit(".", 1)[0] + "-map.md"
        if lines > 1500 or kb > 400:
            if not os.path.exists(mapf):
                fail(f"trace is past the full-read threshold ({lines} lines / "
                     f"{kb}KB) and has NO map",
                     "run `roeh map` — without it the oracle degrades to "
                     "grepping, which silently misses what it did not think to "
                     "search for")
            elif os.path.getmtime(mapf) < os.path.getmtime(cfg["trace_abs"]):
                warn("map is older than the trace",
                     "run `roeh map` (then `roeh verify`) — entries added since "
                     "are invisible to the oracle's first pass")
            else:
                ok(f"past full-read threshold ({lines} lines), map is current")

    # --- ingest completeness ----------------------------------------------
    ing = load_state(cfg).get("ingest") or {}
    if os.path.exists(cfg["trace_abs"]):
        istate = ing.get("state")
        missing = [p for p in ing.get("plan", []) if p not in ing.get("done", [])]
        if not ing:
            warn("no ingest ever recorded for this trace",
                 "predates lifecycle tracking, or was built by hand — "
                 "`roeh ingest status` will keep saying 'unknown'")
        elif istate == "partial" and time.time() - ing.get("started", 0) > INGEST_STALE_AFTER:
            fail(f"an ingest was ABANDONED partway: {len(ing.get('done', []))}"
                 f"/{len(ing.get('plan', []))} units, missing {', '.join(missing)}",
                 "the trace reads as complete but whole chapters were never "
                 "mined — the oracle will say 'not recorded' for decisions that "
                 "are. Re-run /roeh:ingest to finish, or `roeh ingest abandon`")
        elif istate == "partial":
            warn("an ingest appears to be RUNNING right now "
                 f"({len(ing.get('done', []))}/{len(ing.get('plan', []))} units)",
                 "starting another would double-write — let it finish")
        elif istate == "partial-closed":
            fail(f"ingest was closed with {len(ing.get('missing', []))} unit(s) "
                 f"never completed: {', '.join(ing.get('missing', []))}",
                 "re-run /roeh:ingest scoped to those ranges")
        else:
            ok("ingest complete")

    # --- profile ----------------------------------------------------------
    if not os.path.exists(cfg["profile_abs"]):
        warn(f"no profile at {cfg['profile_abs']}",
             "the agents fall back to generic behaviour — /roeh:ingest writes it")
    elif os.path.exists(cfg["trace_abs"]):
        drift = os.path.getmtime(cfg["trace_abs"]) - os.path.getmtime(cfg["profile_abs"])
        if drift > 30 * 86400:
            warn(f"profile is {int(drift//86400)} days behind the trace",
                 "/roeh:refresh — a retired dead-end still listed here makes the "
                 "oracle warn people off the right answer")
        else:
            ok("profile present and current with the trace")

    # --- placement --------------------------------------------------------
    in_repo = os.path.abspath(cfg["trace_abs"]).startswith(os.path.abspath(root) + os.sep)
    if cfg.get("mode") == "local":
        if in_repo:
            fail("mode is 'local' but the trace sits INSIDE the repo",
                 "one `git add -A` publishes it — move it or switch to repo mode")
        else:
            ok("local mode: trace is outside the repo")
    else:
        if not in_repo:
            warn("mode is 'repo' but the trace is outside it",
                 "it will not be versioned, which is the whole point of repo mode")
        elif run(["git", "-C", root, "ls-files", "--error-unmatch",
                  os.path.relpath(cfg["trace_abs"], root)]):
            ok("repo mode: trace is tracked by git (append-only is provable)")
        else:
            warn("repo mode but the trace is NOT tracked by git",
                 f"git add {os.path.relpath(cfg['trace_abs'], root)} — untracked, "
                 "append-only is a promise rather than a property")

    # --- housekeeping -----------------------------------------------------
    gi = os.path.join(root, ".gitignore")
    want = [".claude/roeh-state.json", ".claude/roeh-pending.json"]
    body = open(gi).read() if os.path.exists(gi) else ""
    absent_ig = [w for w in want if w not in body]
    if absent_ig and os.path.isdir(os.path.join(root, ".git")):
        warn("per-machine watermarks not gitignored: " + ", ".join(absent_ig),
             "roeh doctor --fix")
        if fix:
            with open(gi, "a") as f:
                f.write("\n# roeh per-machine watermarks\n"
                        + "\n".join(absent_ig) + "\n")
            findings[-1] = ("FIXED", "added watermarks to .gitignore", None)
    elif not absent_ig:
        ok("watermarks gitignored")

    if not os.path.isdir(cfg["sessions_dir_abs"]):
        warn("no Claude Code transcripts found for this project",
             "session mining will find nothing — expected if you work elsewhere")
    else:
        ok(f"{len(sessions_for(cfg))} transcript(s) discoverable")

    # --- apply safe fixes -------------------------------------------------
    if fix and (missing or (isinstance(found_v, int) and found_v < SCHEMA_VERSION)):
        merged = dict(defaults)
        merged.update(on_disk)          # on-disk values win; only gaps are filled
        merged["version"] = SCHEMA_VERSION
        with open(config_path(root), "w") as f:
            json.dump(merged, f, indent=2, sort_keys=True)
        # Flip the findings this repaired rather than appending beside them —
        # a summary that still counts a warning it just fixed trains people to
        # ignore the count.
        for i, (level, msg, hint) in enumerate(findings):
            if level == "WARN" and ("config schema v" in msg or "config missing key" in msg):
                findings[i] = ("FIXED", msg + "  → migrated", None)

    report(findings, fix)


def report(findings, fix):
    icons = {"OK": "✓", "WARN": "!", "FAIL": "✗", "FIXED": "→"}
    for level, msg, hint in findings:
        print(f"  {icons[level]} {msg}")
        if hint and level != "OK":
            print(f"      {hint}")
    fails = sum(1 for f in findings if f[0] == "FAIL")
    warns = sum(1 for f in findings if f[0] == "WARN")
    print(f"\n{fails} failing, {warns} warning(s)"
          + ("" if fix else ("  —  roeh doctor --fix applies the safe repairs"
                             if warns or fails else "")))
    sys.exit(1 if fails else 0)


PENDING_NAME = "roeh-pending.json"
PENDING_TTL = 600  # seconds


def pending_path(cfg):
    return os.path.join(os.path.dirname(cfg["state_abs"]), PENDING_NAME)


def cmd_pending(args):
    """The handshake between the PreCompact command hook and the scribe.

    Hook handlers within one event have no documented execution order, so the
    scribe cannot rely on being told "you were dispatched by the gate". The
    command hook drops this sentinel; the scribe reads it and switches to
    RECORD mode. Stale sentinels expire, so a scribe consulted by hand an hour
    later does not silently start writing to the record.
    """
    cfg = load_config()
    p = pending_path(cfg)
    if "--write" in args:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        payload = json.load(sys.stdin)
        payload["at"] = time.time()
        with open(p, "w") as f:
            json.dump(payload, f, indent=2)
        return
    if "--clear" in args:
        if os.path.exists(p):
            os.remove(p)
        return
    try:
        with open(p) as f:
            payload = json.load(f)
    except Exception:
        sys.exit(1)  # nothing pending — non-zero so `roeh pending || …` works
    if time.time() - payload.get("at", 0) > PENDING_TTL:
        os.remove(p)
        sys.exit(1)
    print(json.dumps(payload, indent=2, sort_keys=True))


COMMANDS = {"init": cmd_init, "config": cmd_config, "status": cmd_status,
            "append": cmd_append, "record": cmd_record, "id": cmd_id,
            "sessions": cmd_sessions, "mark": cmd_mark, "slug": cmd_slug, "pending": cmd_pending,
            "doctor": cmd_doctor, "ingest": cmd_ingest,
            "map": cmd_map, "read": cmd_read, "scope": cmd_scope, "verify": cmd_verify}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0)
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        die(f"unknown command '{cmd}' (try: {', '.join(sorted(COMMANDS))})")
    COMMANDS[cmd](sys.argv[2:])


if __name__ == "__main__":
    main()
